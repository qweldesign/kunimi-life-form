# お問い合わせフォームの設定
# このファイルを .env という名前でコピーし、値を書き換えて使う。
# .env にはパスワードが含まれるため、Git には含めない（.gitignore 済み）。

# ---- サイト設定 ----
SITE_TITLE="国見 海・人・暮らし相談室"
# Origin / Referer チェックに使う（末尾のスラッシュなし）
SITE_URL="https://kunimi.life"
# 送信元・管理者宛の通知先
ADMIN_EMAIL="welcome@kunimi.life"

# ---- SMTP 設定（heteml 想定）----
SMTP_HOST="smtp.hetemail.jp"
SMTP_USER="welcome@kunimi.life"
SMTP_PASS="********"
SMTP_PORT=587
# tls（STARTTLS, 通常は 587 番）、ssl（SMTPS, 通常は 465 番）、none（暗号化なし。ローカルのテスト用のみ）
SMTP_SECURE=tls

# ---- 項目設定 ----
# 必須項目の name 属性（カンマ区切り）
REQUIRED_FIELDS="メールアドレス,ご住所,電話番号,集合場所,アレルギー"
# メールアドレス入力欄の name 属性
EMAIL_FIELD="メールアドレス"

# ---- 迷惑メール対策 ----
# ボット対策の見えない入力欄 (ハニーポット) の name 属性 (フォームと合わせる)
HONEYPOT_FIELD="website_url"
# 同じ人 (セッション) が続けて送信できるまでの秒数 (0 で制限しない)
SEND_INTERVAL=60

# ---- メールの件名 ----
# 省略すると「サイト名 からのお問い合わせ」「サイト名 へのお問い合わせありがとうございます」
ADMIN_SUBJECT="国見 海・人・暮らし相談室 ツアー参加申し込み"
REPLY_SUBJECT="国見 海・人・暮らし相談室 ツアー参加申し込みを受け付けました"

# ---- 自動返信メールの署名 ----
# ダブルクォートの中は改行をそのまま書ける
MAIL_FOOTER="
後日ご連絡致しますので今しばらくお待ちください。

────────────────────────────────────────────────
国見 海・人・暮らし相談室
お問い合わせ: 0776-88-2004 (国見公民館)
────────────────────────────────────────────────
"
